-- 🧠 STATE
-- ============================================================
local CLAY = {
    Connections = {}, Threads = {},
    Processed = setmetatable({}, {__mode = "k"}),
    Running = true,
    OriginalMaterial = setmetatable({}, {__mode = "k"}),
    BallData = {},
    MaterialAppliedCount = 0,
}
GENV.ClayFPS = CLAY

function CLAY:TrackConn(c) table.insert(self.Connections, c); return c end
function CLAY:TrackThread(t) table.insert(self.Threads, t); return t end

function CLAY:Cleanup()
    self.Running = false
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    for _, t in ipairs(self.Threads) do pcall(function() task.cancel(t) end) end
    for _, d in pairs(self.BallData) do
        if d.proxy then pcall(function() d.proxy:Destroy() end) end
        if d.realBall then pcall(function() d.realBall.LocalTransparencyModifier = 0 end) end
    end
    self.BallData = {}
    self.Connections, self.Threads = {}, {}
    self.Processed = setmetatable({}, {__mode = "k"})
    self.OriginalMaterial = setmetatable({}, {__mode = "k"})
end

-- ============================================================
-- 🌐 ADVANCED NETWORK OPTIMIZER
-- ============================================================
local function applyNetworkOptimizer()
    if not CONFIG.NetworkOptimize then return end
    local ok, s = pcall(function() return settings() end)
    if ok and s then
        pcall(function() s.Network.IncomingReplicationLag = 0 end)
        pcall(function() s.Network.PreferredOutgoingReplicationRate = CONFIG.OutgoingRate end)
    end
    if Workspace.StreamingEnabled then
        pcall(function() Workspace.StreamingTargetRadius = CONFIG.StreamingRadius end)
        pcall(function() Workspace.StreamingPauseMode = Enum.StreamingPauseMode.ClientPhysicsPause end)
    end
    if type(setfflag) == "function" then
        pcall(function()
            if CONFIG.OptimizePhysicsNet then
                setfflag("DFIntS2PhysicsSenderRate", "5")
                setfflag("DFIntS2PhysicsReceiverRate", "5")
            end
            setfflag("DFIntMaxDataPacketsPerSecond", "25") 
            setfflag("FFlagOptimizeNetworkSendData", "true")
        end)
    end
end

-- ============================================================
-- 🧹 LIGHT & CLUTTER CLEANER (ระบบล้างโคมและขยะ)
-- ============================================================
local function clearLightsAndClutter()
    if CONFIG.LightCleanup then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Light") then
                pcall(function() obj:Destroy() end)
            end
        end
    end
    
    if CONFIG.ClutterCleanup then
        -- ลบ Effect ขยะที่ไม่ได้อยู่ใน Protected Path
        local protectedNames = {["Workspace"]=true, ["map"]=true, ["leaderboard"]=true, ["characters"]=true, ["gks"]=true}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire")) then
                -- เช็คว่าอยู่ในแมพหลักหรือไม่ (ถ้าไม่ใช่ ให้ลบทิ้ง)
                local parent = obj.Parent
                local isMap = false
                while parent do
                    if protectedNames[parent.Name] then isMap = true; break end
                    parent = parent.Parent
                end
                if not isMap then
                    pcall(function() obj:Destroy() end)
                end
            end
        end
    end
end

-- ============================================================
-- 🧠 MEMORY MANAGER (ระบบเล่นนานๆ ไม่แล็ค)
-- ============================================================
local function runMemoryCleanup()
    if not CONFIG.MemoryManager then return end
    
    -- 1. ล้าง Reference ของวัตถุที่โดนทำลายไปแล้วใน Table
    local cleaned = 0
    for k in pairs(CLAY.Processed) do
        if not k or not k.Parent then
            CLAY.Processed[k] = nil
            cleaned = cleaned + 1
        end
    end
    for k in pairs(CLAY.OriginalMaterial) do
        if not k or not k.Parent then
            CLAY.OriginalMaterial[k] = nil
            cleaned = cleaned + 1
        end
    end
    
    -- 2. ล้างบอลที่หลุดหาย
    for realBall, d in pairs(CLAY.BallData) do
        if not realBall.Parent or not d.proxy.Parent then
            if d.proxy then d.proxy:Destroy() end
            pcall(function() realBall.LocalTransparencyModifier = 0 end)
            CLAY.BallData[realBall] = nil
        end
    end

    -- 3. บังคับ GC (Garbage Collection)
    local memUsage = math.floor(collectgarbage("count") / 1024) -- MB
    
    -- ถ้า RAM เกินลิมิต หรือถึงรอบล้าง ให้บังคับ GC
    if memUsage > CONFIG.MaxMemoryMB then
        collectgarbage("collect")
    else
        collectgarbage("step") -- ล้างแบบเบาๆ ไม่ให้กระตุก
    end
    
    -- print("[CLAY-FPS] 🧹 เคลียร์ Memory: " .. cleaned .. " รายการ | RAM: " .. memUsage .. " MB")
end

