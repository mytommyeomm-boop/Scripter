    HiddenLights = setmetatable({}, {__mode = "k"}),
    BallData = {}, MaterialAppliedCount = 0, InitDone = false,
}
GENV.ClayFPS = CLAY

function CLAY:TrackConn(c) table.insert(self.Connections, c); return c end
function CLAY:TrackThread(t) table.insert(self.Threads, t); return t end
function CLAY:TrackInst(i) table.insert(self.Instances, i); return i end

function CLAY:Cleanup()
    self.Running = false
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    for _, t in ipairs(self.Threads) do pcall(function() task.cancel(t) end) end
    for _, i in ipairs(self.Instances) do pcall(function() if i and i.Parent then i:Destroy() end end) end
    for _, d in pairs(self.BallData) do
        if d.proxy then pcall(function() d.proxy:Destroy() end) end
        if d.realBall then pcall(function() d.realBall.LocalTransparencyModifier = 0 end) end
    end
    self.BallData = {}
    self.Connections, self.Threads, self.Instances = {}, {}, {}
    self.Processed = setmetatable({}, {__mode = "k"})
    self.FrozenChars = setmetatable({}, {__mode = "k"})
    self.OriginalMaterial = setmetatable({}, {__mode = "k"})
end

function CLAY:Restore()
    local restored = 0
    for part, orig in pairs(self.OriginalMaterial) do
        if part and part.Parent then
            pcall(function()
                part.Material = orig.Material
                part.Reflectance = orig.Reflectance
                part.CastShadow = orig.CastShadow
                part.Color = orig.Color
                if orig.TextureID and part:IsA("MeshPart") then part.TextureID = orig.TextureID end
            end)
            restored = restored + 1
        end
    end
    self.OriginalMaterial = setmetatable({}, {__mode = "k"})
    for snd, vol in pairs(self.OriginalSound) do
        if snd and snd.Parent then pcall(function() snd.Volume = vol end); restored = restored + 1 end
    end
    self.OriginalSound = setmetatable({}, {__mode = "k"})
    for light in pairs(self.HiddenLights) do
        if light and light.Parent then pcall(function() light.Enabled = true end); restored = restored + 1 end
    end
    self.HiddenLights = setmetatable({}, {__mode = "k"})
    if CONFIG.ShowToast then
        self:Notify(("♻️ คืนค่าสภาพเดิม %d รายการ"):format(restored), {color = Color3.fromRGB(120,200,255)})
    end
end

-- ============================================================
-- 🛡️ 5. PROTECTION
-- ============================================================
local protectedRoots = {}
for _, path in ipairs(CONFIG.ProtectedPaths) do
    local ok, obj = pcall(function()
        local parts = {}
        for seg in path:gmatch("[^%.]+") do parts[#parts+1] = seg end
        local cur = game
        for _, p in ipairs(parts) do cur = cur[p] end
        return cur
    end)
    if ok and obj then protectedRoots[obj] = true end
end

local function isProtected(inst)
    if not inst then return false end
    local cur = inst
    while cur do
        if protectedRoots[cur] then return true end
        cur = cur.Parent
    end
    return false
end

local function isLocalChar(inst)
    if not CONFIG.ProtectLocalCharacter then return false end
    local char = LP.Character
    if not char then return false end
    local cur = inst
    while cur do
        if cur == char then return true end
        cur = cur.Parent
    end
    return false
end

