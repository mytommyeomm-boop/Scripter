--[[
    🎨 CLAY-FPS v5.3.4 — DELTA SAFE EDITION
    - แก้ไขปัญหา attempt to call a nil value บน Delta Executor
    - เพิ่ม Fallback สำหรับ getgenv, setfflag, setfpscap
    - ปรับโครงสร้างให้เรียบง่าย ปลอดภัย และรันผ่านมือถือได้เสถียร
]]

-- ============================================================
-- 🛡️ COMPATIBILITY LAYER (สำคัญที่สุดสำหรับ Delta)
-- ============================================================
local GENV
-- ตรวจสอบ getgenv อย่างปลอดภัย
pcall(function()
    if type(getgenv) == "function" then
        GENV = getgenv()
    end
end)
if not GENV then GENV = _G end

-- Fallback setfflag (ถ้า Delta ไม่มี จะไม่ทำให้สคริปต์พัง)
if type(setfflag) ~= "function" then
    setfflag = function(name, value) return true end
end

-- Fallback setfpscap
if type(setfpscap) ~= "function" then
    setfpscap = function(cap) return true end
end

-- ============================================================
-- 🔄 AUTO-RELOAD
-- ============================================================
if type(GENV.ClayFPS) == "table" and type(GENV.ClayFPS.Cleanup) == "function" then
    pcall(function() GENV.ClayFPS:Cleanup() end)
end

-- ============================================================
-- 📦 SERVICES
-- ============================================================
local Players      = game:GetService("Players")
local Lighting     = game:GetService("Lighting")
local Workspace    = game:GetService("Workspace")
local RunService   = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Stats        = game:GetService("Stats")
local LP           = Players.LocalPlayer

-- ============================================================
-- ⚙️ CONFIG (ปรับแต่งได้ตามต้องการ)
-- ============================================================
local CONFIG = {
    -- การป้องกันแผนที่ (ไม่ให้สคริปต์ไปยุ่งกับ Map หลัก)
    ProtectedPaths = {
        "Workspace.map", "Workspace.leaderboard", "Workspace.characters",
        "Workspace.gks", "Workspace.overtime",
    },
    -- เปิด/ปิดฟีเจอร์หลัก
    ClayLook = true,          -- เปลี่ยนทุกอย่างเป็นดินน้ำมัน
    RemoveTextures = true,    -- ลบพื้นผิว/Decal
    RemoveEffects = true,     -- ลบเอฟเฟกต์
    RemoveLights = true,      -- ลบแสง
    RemoveUnneededObjects = true, -- ลบโมเดลไม่จำเป็น
    BallSmoothing = true,     -- ทำให้บอลลื่น
    EnableHitbox = true,      -- เปิด Hitbox
    ShowHUD = true,           -- แสดง FPS/Ping
    
    -- ค่าปรับแต่งประสิทธิภาพ
    MaxFPS = 60,
    QualityLevel = 1,
}

-- ============================================================
-- 🧠 STATE
-- ============================================================
local CLAY = {
    Connections = {}, Threads = {},
    Processed = setmetatable({}, {__mode = "k"}),
    Running = true, Version = "5.3.4",
    FrozenChars = setmetatable({}, {__mode = "k"}),
    OriginalMaterial = setmetatable({}, {__mode = "k"}),
    BallData = {},
    MaterialAppliedCount = 0,
}
GENV.ClayFPS = CLAY

function CLAY:TrackConn(c) table.insert(self.Connections, c); return c end
function CLAY:TrackThread(t) table.insert(self.Threads, t); return t end

function CLAY:Cleanup()
    self.Running = false
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    for _, t in ipairs(self.Threads) do pcall(function() task.cancel(t) end) end
    for _, d in pairs(self.BallData) do
        if d.proxy then pcall(function() d.proxy:Destroy() end) end
        if d.realBall then pcall(function() d.realBall.LocalTransparencyModifier = 0 end) end
    end
    self.Connections, self.Threads = {}, {}
    self.Processed = setmetatable({}, {__mode = "k"})
    self.FrozenChars = setmetatable({}, {__mode = "k"})
    self.OriginalMaterial = setmetatable({}, {__mode = "k"})
    self.BallData = {}
end

-- ============================================================
-- 🛡️ PROTECTION
-- ============================================================
local protectedRoots = {}
for _, path in ipairs(CONFIG.ProtectedPaths) do
    local ok, obj = pcall(function()
        local parts = {}
        for seg in path:gmatch("[^%.]+") do parts[#parts+1] = seg end
        local cur = game
        for _, p in ipairs(parts) do cur = cur[p] end
        return cur
    end)
    if ok and obj then protectedRoots[obj] = true end
end

local function isProtected(inst)
    if not inst then return false end
    local cur = inst
    while cur do
        if protectedRoots[cur] then return true end
        cur = cur.Parent
    end
    return false
end

local function isLocalChar(inst)
    local char = LP.Character
    if not char then return false end
    local cur = inst
    while cur do
        if cur == char then return true end
        cur = cur.Parent
    end
    return false
end

-- ============================================================
-- 🎯 BALL SMOOTHER (ฉบับย่อ)
-- ============================================================
local function isBall(name)
    name = name:lower()
    return name:find("ball") or name:find("soccer") or name:find("football")
end

local function initBall(realBall)
    if CLAY.BallData[realBall] or not CONFIG.BallSmoothing then return end
    local proxy = Instance.new("Part")
    proxy.Name = "CLAY_BALLPROXY"
    proxy.Size = realBall.Size
    proxy.Color = realBall.Color
    proxy.Material = Enum.Material.SmoothPlastic
    proxy.Transparency = realBall.Transparency
    proxy.CanCollide = false
    proxy.CanTouch = false
    proxy.Anchored = true
    proxy.CastShadow = false
    proxy.CFrame = realBall.CFrame
    proxy.Parent = Workspace
    realBall.LocalTransparencyModifier = 1

    CLAY.BallData[realBall] = { proxy = proxy, smoothVel = Vector3.new() }
end

-- ============================================================
-- 🧱 MATERIAL BATCH (เปลี่ยนเป็นดินน้ำมัน)
-- ============================================================
local matQueue, matSize = {}, 0

local function queueMaterial(part)
    if not part or not part.Parent or part:FindFirstChild("CLAY_HB") then return end
    matSize = matSize + 1
    matQueue[matSize] = part
end

local function drainMaterials()
    if matSize == 0 then return end
    local n = math.min(matSize, 10)
    for i = 1, n do
        local p = matQueue[i]
        if p and p.Parent and not isProtected(p) and not isLocalChar(p) then
            pcall(function()
                if not CLAY.OriginalMaterial[p] then
                    CLAY.OriginalMaterial[p] = { Material = p.Material, Color = p.Color }
                end
                p.Material = Enum.Material.SmoothPlastic
                p.Reflectance = 0
                if CONFIG.RemoveTextures and p:IsA("MeshPart") then
                    p.TextureID = ""
                end
                CLAY.MaterialAppliedCount = CLAY.MaterialAppliedCount + 1
            end)
        end
    end
    -- ล้างคิว
    for i = 1, n do matQueue[i] = nil end
    matSize = matSize - n
end

-- ============================================================
-- 🧱 TOUCH (ตรวจสอบและจัดการวัตถุ)
-- ============================================================
local function touch(inst)
    if not inst or not inst.Parent or inst.Name:sub(1,5) == "CLAY_" then return end
    if isProtected(inst) or isLocalChar(inst) then return end

    if CONFIG.RemoveEffects and (inst:IsA("ParticleEmitter") or inst:IsA("Trail")
        or inst:IsA("Beam") or inst:IsA("Smoke") or inst:IsA("Fire")) then
        pcall(function() inst:Destroy() end); return
    end
    if CONFIG.RemoveLights and inst:IsA("Light") then
        pcall(function() inst:Destroy() end); return
    end
    if inst:IsA("Sound") then
        pcall(function() inst.Volume = 0 end); return
    end
    if CONFIG.RemoveTextures and (inst:IsA("Decal") or inst:IsA("Texture")) then
        pcall(function() inst:Destroy() end); return
    end
    if CONFIG.ClayLook and inst:IsA("BasePart") then
        if isBall(inst.Name) then initBall(inst) else queueMaterial(inst) end
    end
end

-- ============================================================
-- 🔍 INIT SCAN (สแกนแบบเบาๆ ไม่ให้เกมค้าง)
-- ============================================================
local function initScan()
    local stack = { Workspace }
    local idx = 1
    while idx <= #stack do
        if not CLAY.Running then return end
        local cur = stack[idx]
        stack[idx] = nil
        idx = idx + 1
        if cur and cur.Parent then
            touch(cur)
            for _, ch in ipairs(cur:GetChildren()) do
                stack[#stack+1] = ch
            end
        end
        -- Yield ทุกๆ 50 วัตถุ เพื่อไม่ให้เฟรมเรตตก
        if idx % 50 == 0 then task.wait() end
    end
end

-- ============================================================
-- 📊 HUD (แสดง FPS/Ping)
-- ============================================================
local HUD = {}
local pingStat = Stats.Network.ServerStatsItem["Data Ping"]

local function makeHUD()
    local pg = LP:FindFirstChild("PlayerGui"); if not pg then return end
    local old = pg:FindFirstChild("CLAY_HUD"); if old then old:Destroy() end
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.DisplayOrder = "CLAY_HUD", false, 9999
    gui.Parent = pg
    local frame = Instance.new("Frame")
    frame.Size, frame.Position = UDim2.new(0, 180, 0, 40), UDim2.new(1, -190, 0, 10)
    frame.BackgroundColor3, frame.BackgroundTransparency = Color3.new(0,0,0), 0.5
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 1, -10)
    label.Position = UDim2.new(0, 5, 0, 5)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = "FPS: -- | Ping: --"
    label.Parent = frame
    HUD.line = label
end

