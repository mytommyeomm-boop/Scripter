local HUD = {}
local pingStat = Stats.Network.ServerStatsItem["Data Ping"]

local function makeHUD()
    local pg = LP:FindFirstChild("PlayerGui"); if not pg then return end
    local old = pg:FindFirstChild("CLAY_HUD"); if old then old:Destroy() end
    local gui = Instance.new("ScreenGui"); gui.Name, gui.ResetOnSpawn, gui.DisplayOrder = "CLAY_HUD", false, 9999
    gui.Parent = pg
    local f = Instance.new("Frame"); f.Size, f.Position = UDim2.new(0,260,0,46), UDim2.new(1,-268,0,8)
    f.BackgroundColor3, f.BackgroundTransparency = Color3.fromRGB(20,18,16), 0.35; f.BorderSizePixel = 0; f.Parent = gui
    Instance.new("UICorner", f).CornerRadius = UDim.new(0,8)
    
    local ln = Instance.new("TextLabel"); ln.Size, ln.Position = UDim2.new(1,-12,0,22), UDim2.new(0,6,0,12)
    ln.BackgroundTransparency = 1; ln.TextColor3 = Color3.fromRGB(230,230,230); ln.Font, ln.TextSize = Enum.Font.GothamBold, 13
    ln.TextXAlignment, ln.RichText = Enum.TextXAlignment.Left, true; ln.Parent = f; HUD.line = ln
end

