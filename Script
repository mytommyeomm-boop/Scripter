pcall(function()
    UserSettings():GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
end)
if CONFIG.MaxFPS > 0 then pcall(setfpscap, CONFIG.MaxFPS) end

-- 2. ตั้งค่าแสง
pcall(function()
    Lighting.GlobalShadows = false
    Lighting.Brightness = 2
    Lighting.Ambient = Color3.fromRGB(100, 100, 100)
    Lighting.FogEnd = 100000
end)

-- 3. ลบโมเดลไม่จำเป็น
if CONFIG.RemoveUnneededObjects then
    local paths = {
        "Workspace.Effects", "Workspace.nightsdevs", "Workspace.Marbles",
        "Workspace.MarbleFx", "Workspace.cs2_visuals", "Workspace.temp",
    }
    for _, path in ipairs(paths) do
        local obj = game
        for seg in path:gmatch("[^%.]+") do obj = obj[seg] end
        if obj then pcall(function() obj:Destroy() end) end
        task.wait(0.1)
    end
end

-- 4. สร้าง HUD
if CONFIG.ShowHUD then pcall(makeHUD) end

-- 5. เริ่มสแกน
CLAY:TrackThread(task.spawn(function()
    task.wait(0.5) -- รอให้เกมโหลดก่อน
    initScan()
    if CONFIG.ShowHUD then
        CLAY:TrackThread(task.spawn(function()
            while CLAY.Running do
                local fps = math.floor(1 / RunService.RenderStepped:Wait())
                local ping = 0
                pcall(function() ping = math.floor(pingStat:GetValue()) end)
                if HUD.line then
                    HUD.line.Text = string.format("FPS: %d | Ping: %dms", fps, ping)
                end
                task.wait(0.5)
            end
        end))
    end
end))

-- 6. อัปเดตวัตถุใหม่ที่เข้ามา
CLAY:TrackConn(Workspace.DescendantAdded:Connect(function(d)
    touch(d)
end))

-- 7. ลูปเปลี่ยน Material
CLAY:TrackThread(task.spawn(function()
    while CLAY.Running do
        drainMaterials()
        task.wait()
    end
end))

-- 8. ลูปอัปเดตบอล
CLAY:TrackThread(task.spawn(function()
    while CLAY.Running do
        for realBall, data in pairs(CLAY.BallData) do
            if realBall.Parent and data.proxy then
                data.proxy.CFrame = realBall.CFrame
            end
        end
        task.wait()
    end
end))

print("[CLAY-FPS v5.3.4] ✅ โหลดสำเร็จ! | Clay Parts:", CLAY.MaterialAppliedCount)
