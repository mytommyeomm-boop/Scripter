-- สแกนทุกอย่างในเกม
CLAY:TrackThread(task.spawn(function()
    task.wait(0.5)
    local stack, idx = { Workspace }, 1
    while idx <= #stack do
        local cur = stack[idx]; stack[idx] = nil; idx = idx + 1
        if cur and cur.Parent then
            touch(cur)
            if cur:IsA("BasePart") and isBall(cur.Name) then initBall(cur) end
            for _, ch in ipairs(cur:GetChildren()) do stack[#stack+1] = ch end
        end
        if idx % 100 == 0 then task.wait() end
    end
end))

-- ดักจับวัตถุใหม่
CLAY:TrackConn(Workspace.DescendantAdded:Connect(touch))

-- ลูปหลัก (อัปเดตระบบ)
CLAY:TrackThread(task.spawn(function()
    while CLAY.Running do
        drainMaterials()
        if CONFIG.ShowHUD and HUD.line and HUD.line.Parent then
            local fps = math.floor(1 / RunService.RenderStepped:Wait())
            local ping = 0; pcall(function() ping = math.floor(pingStat:GetValue()) end)
            local ballCount = 0; for _ in pairs(CLAY.BallData) do ballCount = ballCount + 1 end
            
            local pingColor = ping < 100 and "#78FF8C" or (ping < 200 and "#FFE678" or "#FF6E6E")
            local fpsColor = fps >= 50 and "#78FF8C" or (fps >= 30 and "#FFE678" or "#FF6E6E")
            
            HUD.line.Text = string.format("FPS <font color=\"%s\"><b>%d</b></font> | Ping <font color=\"%s\"><b>%dms</b></font> | Clay: %d", fpsColor, fps, pingColor, ping, CLAY.MaterialAppliedCount)
        else
            task.wait()
        end
    end
end))

-- ลูปอัปเดตบอล
CLAY:TrackThread(task.spawn(function()
    while CLAY.Running do
        RunService.RenderStepped:Wait()
        for realBall in pairs(CLAY.BallData) do sampleBall(realBall) end
        renderBalls()
    end
end))

-- 🧹 ลูปจัดการ Memory & ขยะ (ระบบเล่นนานๆ ไม่แล็ค)
CLAY:TrackThread(task.spawn(function()
    while CLAY.Running do
        task.wait(CONFIG.MemoryCleanupInterval)
        if CLAY.Running then
            runMemoryCleanup() -- ล้าง Memory
            
            if CONFIG.ClutterCleanup then
                clearLightsAndClutter() -- กวาดล้าง Effect ขยะที่เกิดใหม่
            end
