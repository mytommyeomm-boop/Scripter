-- เริ่มสแกนแบบ Staggered (ไม่ให้เกมค้างตอนรันสคริปต์)
CLAY:TrackThread(task.spawn(function()
    task.wait(0.5) -- รอ UI หลักของเกมโหลดก่อน
    local stack, idx = { Workspace }, 1
    while idx <= #stack do
        if not CLAY.Running then return end
        local cur = stack[idx]; stack[idx] = nil; idx = idx + 1
        if cur and cur.Parent then
            touch(cur)
            for _, ch in ipairs(cur:GetChildren()) do stack[#stack+1] = ch end
        end
        -- Yield ทุกๆ 100 วัตถุ
        if idx % 100 == 0 then task.wait() end
    end
end))

