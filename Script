-- ============================================================
-- 🧠 STATE
-- ============================================================
local CLAY = {
    Connections = {}, Threads = {},
    Processed = setmetatable({}, {__mode = "k"}),
    Running = true,
    OriginalMaterial = setmetatable({}, {__mode = "k"}),
    BallData = {},
    MaterialAppliedCount = 0,
}
GENV.ClayFPS = CLAY

function CLAY:TrackConn(c) table.insert(self.Connections, c); return c end
function CLAY:TrackThread(t) table.insert(self.Threads, t); return t end

function CLAY:Cleanup()
    self.Running = false
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    for _, t in ipairs(self.Threads) do pcall(function() task.cancel(t) end) end
    for _, d in pairs(self.BallData) do
        if d.proxy then pcall(function() d.proxy:Destroy() end) end
        if d.realBall then pcall(function() d.realBall.LocalTransparencyModifier = 0 end) end
    end
    self.BallData = {}
    self.Connections, self.Threads = {}, {}
    self.Processed = setmetatable({}, {__mode = "k"})
    self.OriginalMaterial = setmetatable({}, {__mode = "k"})
end

-- ============================================================
-- 🛡️ PROTECTION SYSTEM
-- ============================================================
local protectedRoots = {}
for _, path in ipairs(CONFIG.ProtectedPaths) do
    local ok, obj = pcall(function()
        local parts = {}
        for seg in path:gmatch("[^%.]+") do parts[#parts+1] = seg end
        local cur = game
        for _, p in ipairs(parts) do cur = cur[p] end
        return cur
    end)
    if ok and obj then protectedRoots[obj] = true end
end

local function isProtected(inst)
    if not inst then return false end
    local cur = inst
    while cur do
        if protectedRoots[cur] then return true end
        cur = cur.Parent
    end
    return false
end

local function isLocalChar(inst)
    if not CONFIG.ProtectLocalCharacter then return false end
    local char = LP.Character
    if not char then return false end
    local cur = inst
    while cur do
        if cur == char then return true end
        cur = cur.Parent
    end
    return false
end

-- ============================================================
-- 🌐 NETWORK OPTIMIZER
-- ============================================================
local function applyNetworkOptimizer()
    if not CONFIG.NetworkOptimize then return end
    
    local ok, s = pcall(function() return settings() end)
    if ok and s then
        pcall(function() s.Network.IncomingReplicationLag = 0 end)
        pcall(function() s.Network.PreferredOutgoingReplicationRate = CONFIG.OutgoingRate end)
    end
    
    if Workspace.StreamingEnabled then
        pcall(function() Workspace.StreamingTargetRadius = CONFIG.StreamingRadius end)
        pcall(function() Workspace.StreamingPauseMode = Enum.StreamingPauseMode.ClientPhysicsPause end)
    end
    
    if type(setfflag) == "function" then
        pcall(function()
            setfflag("DFIntS2PhysicsSenderRate", "5")
            setfflag("DFIntS2PhysicsReceiverRate", "5")
            setfflag("DFIntMaxDataPacketsPerSecond", "30")
            setfflag("FFlagOptimizeNetworkSendData", "true")
        end)
    end
end

-- ============================================================
-- 🎨 CLAY VISUAL SYSTEM (ระบบภาพดินน้ำมัน)
-- ============================================================
local function applyClayLighting()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Brightness = 2.5
        Lighting.Ambient = Color3.fromRGB(100, 98, 102)
        Lighting.OutdoorAmbient = Color3.fromRGB(120, 118, 122)
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.FogStart = 0
        Lighting.FogEnd = 100000
        Lighting.FogColor = Color3.fromRGB(255, 255, 255)
    end)
    
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then 
            pcall(function() obj:Destroy() end) 
        end
    end
    
    local cc = Lighting:FindFirstChild("CLAY_GRADE")
    if not cc then
        cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "CLAY_GRADE"
        cc.Parent = Lighting
    end
    cc.Saturation = CONFIG.ClayMuteColors and -0.4 or -0.1 
    cc.Contrast = 0.15
    cc.Brightness = 0.05
    cc.TintColor = Color3.fromRGB(255, 248, 245)
end

-- ============================================================
-- 🧱 TOUCH & MATERIAL BATCH (ระบบเปลี่ยนดินน้ำมัน - แก้บั๊กคิวพัง)
-- ============================================================
local matQueue = {}

local function touch(inst)
    if not inst or not inst.Parent or inst.Name:sub(1,5) == "CLAY_" or CLAY.Processed[inst] then return end
    CLAY.Processed[inst] = true
    
    if isLocalChar(inst) then return end
    
    local isProt = isProtected(inst)

    -- 1. จัดการเอฟเฟกต์ (ถ้าติด Protected ห้ามลบ แต่ถ้าไม่ติดให้ลบ)
    if CONFIG.RemoveEffects and (inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") or inst:IsA("Smoke") or inst:IsA("Fire")) then
        if not isProt then pcall(function() inst:Destroy() end) end
        return
    end
    
    -- 2. จัดการแสง
    if CONFIG.RemoveLights and inst:IsA("Light") then 
        if not isProt then pcall(function() inst:Destroy() end) end
        return 
    end
    
    -- 3. จัดการเสียง
    if inst:IsA("Sound") then pcall(function() inst.Volume = 0 end); return end
    
    -- 4. จัดการพื้นผิว (ถ้าติด Protected ห้ามลบ)
    if CONFIG.RemoveTextures and (inst:IsA("Decal") or inst:IsA("Texture") or inst:IsA("SurfaceAppearance")) then 
        if not isProt then pcall(function() inst:Destroy() end) end
        return 
    end
    
    -- 5. เปลี่ยนเป็นดินน้ำมัน (ทำงานทุกที่ ถ้าเปิด ClayMapToo)
    if CONFIG.ClayLook and inst:IsA("BasePart") then
        if isProt and not CONFIG.ClayMapToo then return end
        table.insert(matQueue, inst) -- ใช้ table.insert เพื่อความถูกต้อง
    end
end

local function drainMaterials()
    if #matQueue == 0 then return end
    -- ✅ เพิ่มความเร็วเป็น 30 ชิ้นต่อเฟรม (Material เปลี่ยนเร็วและไม่กระตุก)
    local n = math.min(#matQueue, 30) 
    
    for _ = 1, n do
        local p = table.remove(matQueue, 1) -- ✅ ใช้ table.remove แก้บั๊กคิวพัง
        if p and p.Parent then
            pcall(function()
                if not CLAY.OriginalMaterial[p] then
                    CLAY.OriginalMaterial[p] = { Material = p.Material, Color = p.Color }
                end
                
                p.Material = Enum.Material.SmoothPlastic
                p.Reflectance = 0
                
                -- ปรับสีให้หม่นลง (Mute Colors)
                if CONFIG.ClayMuteColors and p.Color then
                    local c = p.Color
                    local gray = c.R * 0.299 + c.G * 0.587 + c.B * 0.114
                    p.Color = Color3.new(c.R * 0.6 + gray * 0.4, c.G * 0.6 + gray * 0.4, c.B * 0.6 + gray * 0.4)
                end
                
                if CONFIG.RemoveTextures and p:IsA("MeshPart") then p.TextureID = "" end
                CLAY.MaterialAppliedCount = CLAY.MaterialAppliedCount + 1
            end)
        end
    end
end

-- ============================================================
-- ⚽ BALL SMOOTHER
-- ============================================================
local function isBall(name)
    name = name:lower()
    return name == "ball" or name == "soccerball" or name == "soccer ball" or name == "football" or name == "ballon"
end

local function initBall(realBall)
    if CLAY.BallData[realBall] or not CONFIG.BallSmoothing then return end
    local count = 0
    for _ in pairs(CLAY.BallData) do count = count + 1 end
    if count >= CONFIG.MaxBalls then return end

    local proxy = Instance.new("Part")
    proxy.Name = "CLAY_BALLPROXY"
    proxy.Size = realBall.Size; proxy.Color = realBall.Color
    proxy.Material = Enum.Material.SmoothPlastic
    proxy.Transparency = realBall.Transparency
    proxy.CanCollide, proxy.CanTouch, proxy.CanQuery = false, false, false
    proxy.Anchored = true; proxy.CastShadow = false
    proxy.CFrame = realBall.CFrame; proxy.Parent = Workspace
    realBall.LocalTransparencyModifier = 1

    if CONFIG.BallHighlight then
        local hl = Instance.new("Highlight")
        hl.Name = "CLAY_HL"; hl.FillColor = Color3.fromRGB(255,255,80)
        hl.FillTransparency = 0.75; hl.OutlineColor = Color3.fromRGB(255,255,80)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = proxy; hl.Parent = proxy
    end

    CLAY.BallData[realBall] = {
        proxy = proxy, 
        history = { { t = os.clock(), pos = realBall.CFrame.Position, rot = realBall.CFrame.Rotation } },
        smoothVel = Vector3.new(), 
    }
end

local function sampleBall(realBall)
    local d = CLAY.BallData[realBall]; if not d or not realBall.Parent then return end
    local now, pos, rot = os.clock(), realBall.CFrame.Position, realBall.CFrame.Rotation
    local last = d.history[#d.history]
    if last then
        local dt = now - last.t
        if dt > 0.001 then
            local instVel = (pos - last.pos) / dt
            if instVel.Magnitude < 800 then d.smoothVel = d.smoothVel:Lerp(instVel, 0.35)
            else d.smoothVel = Vector3.new(); d.history = {} end
        end
    end
    table.insert(d.history, { t = now, pos = pos, rot = rot })
    if #d.history > 10 then table.remove(d.history, 1) end
end

local function renderBalls()
    if not CONFIG.BallSmoothing then return end
    local now = os.clock()
    for realBall, d in pairs(CLAY.BallData) do
        if not realBall.Parent or not d.proxy or not d.proxy.Parent then
            if d.proxy then d.proxy:Destroy() end
            pcall(function() realBall.LocalTransparencyModifier = 0 end)
            CLAY.BallData[realBall] = nil
            continue
        end
        local h = d.history
        if #h < 2 then d.proxy.CFrame = realBall.CFrame
        else
            local prev, nxt, found = h[1], h[#h], false
            for i = 1, #h - 1 do
                if h[i].t <= now and h[i+1].t >= now then prev, nxt, found = h[i], h[i+1], true; break end
            end
            if found then
                local span = nxt.t - prev.t
                local alpha = span > 0.0001 and math.clamp((now - prev.t) / span, 0, 1) or 0
                d.proxy.CFrame = CFrame.new(prev.pos:Lerp(nxt.pos, alpha)) * prev.rot:Lerp(nxt.rot, alpha)
            else
                local dt = math.clamp(now - h[#h].t, 0, 0.12)
                d.proxy.CFrame = CFrame.new(h[#h].pos + d.smoothVel * dt) * h[#h].rot
            end
        end
    end
end

