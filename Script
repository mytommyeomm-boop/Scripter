local function applyClayLighting()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Brightness = 2.5
        Lighting.Ambient = Color3.fromRGB(100, 98, 102)
        Lighting.OutdoorAmbient = Color3.fromRGB(120, 118, 122)
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.FogStart = 0
        Lighting.FogEnd = 100000
    end)
    
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then 
            pcall(function() obj:Destroy() end) 
        end
    end
    
    local cc = Lighting:FindFirstChild("CLAY_GRADE")
    if not cc then
        cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "CLAY_GRADE"
        cc.Parent = Lighting
    end
    cc.Saturation = CONFIG.MuteColors and -0.5 or -0.1 
    cc.Contrast = 0.15
    cc.Brightness = 0.05
    cc.TintColor = Color3.fromRGB(255, 248, 245)
end

-- ============================================================
-- 🧱 MATERIAL BATCH & TOUCH
-- ============================================================
local matQueue = {}

local function touch(inst)
    if not inst or not inst.Parent or inst.Name:sub(1,5) == "CLAY_" or CLAY.Processed[inst] then return end
    CLAY.Processed[inst] = true

    if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Light") then
        pcall(function() inst:Destroy() end)
        return
    end
    if inst:IsA("Sound") then
        pcall(function() inst.Volume = 0 end)
        return
    end
    if inst:IsA("Decal") or inst:IsA("Texture") or inst:IsA("SurfaceAppearance") then
        pcall(function() inst:Destroy() end)
        return
    end
    if inst:IsA("SpecialMesh") then
        pcall(function() inst.TextureId = "" end)
        return
    end

    if CONFIG.ForceClayEverything and inst:IsA("BasePart") then
        table.insert(matQueue, inst)
    end
end

local function drainMaterials()
    if #matQueue == 0 then return end
    local n = math.min(#matQueue, 40) 
    
    for _ = 1, n do
        local p = table.remove(matQueue, 1)
        if p and p.Parent then
            pcall(function()
                if not CLAY.OriginalMaterial[p] then
                    CLAY.OriginalMaterial[p] = { Material = p.Material, Color = p.Color }
                end
                
                p.Material = Enum.Material.SmoothPlastic
                p.Reflectance = 0
                p.CastShadow = false
                
                if p:IsA("MeshPart") then 
                    p.TextureID = "" 
                    p.MaterialVariant = ""
                end
                
                if CONFIG.MuteColors and p.Color then
                    local c = p.Color
                    local gray = c.R * 0.299 + c.G * 0.587 + c.B * 0.114
                    p.Color = Color3.new(c.R * 0.4 + gray * 0.6, c.G * 0.4 + gray * 0.6, c.B * 0.4 + gray * 0.6)
                end
                
                CLAY.MaterialAppliedCount = CLAY.MaterialAppliedCount + 1
            end)
        end
    end
end

-- ============================================================
-- ⚽ BALL SMOOTHER
-- ============================================================
local function isBall(name)
    name = name:lower()
    return name == "ball" or name == "soccerball" or name == "soccer ball" or name == "football" or name == "ballon"
end

local function initBall(realBall)
    if CLAY.BallData[realBall] or not CONFIG.BallSmoothing then return end
    local count = 0
    for _ in pairs(CLAY.BallData) do count = count + 1 end
    if count >= CONFIG.MaxBalls then return end

    local proxy = Instance.new("Part")
    proxy.Name = "CLAY_BALLPROXY"
    proxy.Size = realBall.Size; proxy.Color = realBall.Color
    proxy.Material = Enum.Material.SmoothPlastic
    proxy.Transparency = realBall.Transparency
    proxy.CanCollide, proxy.CanTouch, proxy.CanQuery = false, false, false
    proxy.Anchored = true; proxy.CastShadow = false
    proxy.CFrame = realBall.CFrame; proxy.Parent = Workspace
    realBall.LocalTransparencyModifier = 1

    CLAY.BallData[realBall] = {
        proxy = proxy, 
        history = { { t = os.clock(), pos = realBall.CFrame.Position, rot = realBall.CFrame.Rotation } },
        smoothVel = Vector3.new(), 
    }
end

local function sampleBall(realBall)
    local d = CLAY.BallData[realBall]; if not d or not realBall.Parent then return end
    local now, pos, rot = os.clock(), realBall.CFrame.Position, realBall.CFrame.Rotation
    local last = d.history[#d.history]
    if last then
        local dt = now - last.t
        if dt > 0.001 then
            local instVel = (pos - last.pos) / dt
            if instVel.Magnitude < 800 then d.smoothVel = d.smoothVel:Lerp(instVel, 0.35)
            else d.smoothVel = Vector3.new(); d.history = {} end
        end
    end
    table.insert(d.history, { t = now, pos = pos, rot = rot })
    if #d.history > 10 then table.remove(d.history, 1) end
end

local function renderBalls()
    if not CONFIG.BallSmoothing then return end
    local now = os.clock()
    for realBall, d in pairs(CLAY.BallData) do
        if not realBall.Parent or not d.proxy or not d.proxy.Parent then
            if d.proxy then d.proxy:Destroy() end
            pcall(function() realBall.LocalTransparencyModifier = 0 end)
            CLAY.BallData[realBall] = nil
            continue
        end
        local h = d.history
        if #h < 2 then d.proxy.CFrame = realBall.CFrame
        else
            local prev, nxt, found = h[1], h[#h], false
            for i = 1, #h - 1 do
                if h[i].t <= now and h[i+1].t >= now then prev, nxt, found = h[i], h[i+1], true; break end
            end
            if found then
                local span = nxt.t - prev.t
                local alpha = span > 0.0001 and math.clamp((now - prev.t) / span, 0, 1) or 0
                d.proxy.CFrame = CFrame.new(prev.pos:Lerp(nxt.pos, alpha)) * prev.rot:Lerp(nxt.rot, alpha)
            else
                local dt = math.clamp(now - h[#h].t, 0, 0.12)
                d.proxy.CFrame = CFrame.new(h[#h].pos + d.smoothVel * dt) * h[#h].rot
            end
        end
    end
end

