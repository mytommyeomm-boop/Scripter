-- 🎥 9. CAMERA GATE & LIGHTING
-- ============================================================
local camMotion = { rotating = false, stableTime = 1, lastLook = Vector3.new(0,0,-1), lastPos = Vector3.new() }
local function updateCamMotion()
    local cam = Workspace.CurrentCamera; if not cam then return end
    local look, pos = cam.CFrame.LookVector, cam.CFrame.Position
    if (look - camMotion.lastLook).Magnitude > CONFIG.CamRotThreshold or (pos - camMotion.lastPos).Magnitude > CONFIG.CamPosThreshold then
        camMotion.stableTime, camMotion.rotating = 0, true
    else
        camMotion.stableTime = camMotion.stableTime + (1/60)
        if camMotion.stableTime >= CONFIG.CamStableTime then camMotion.rotating = false end
    end
    camMotion.lastLook, camMotion.lastPos = look, pos
end

local function applyLightingAndFog()
    pcall(function()
        Lighting.GlobalShadows = not CONFIG.RemoveShadows
        Lighting.Brightness = 2.5; Lighting.Ambient = Color3.fromRGB(100,98,102)
        Lighting.FogStart = 0; Lighting.FogEnd = 100000; Lighting.FogColor = Color3.fromRGB(255,255,255)
    end)
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then pcall(function() obj:Destroy() end) end
    end
    if CONFIG.ClayGrade then
        local cc = Instance.new("ColorCorrectionEffect"); cc.Name = "CLAY_GRADE"
        cc.Saturation = -0.25; cc.Contrast = 0.10; cc.Brightness = 0.03
        cc.Parent = Lighting; CLAY:TrackInst(cc)
    end
end

-- ============================================================
-- 🧱 10. MATERIAL BATCH & TOUCH
-- ============================================================
local matQueue, matSize = {}, 0
local function touch(inst)
    if not inst or not inst.Parent or inst.Name:sub(1,5) == "CLAY_" or CLAY.Processed[inst] then return end
    CLAY.Processed[inst] = true
    if isProtected(inst) or isLocalChar(inst) then return end

    if CONFIG.RemoveEffects and (inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") or inst:IsA("Smoke") or inst:IsA("Fire")) then
        pcall(function() inst:Destroy() end); return
    end
    if CONFIG.RemoveLights and inst:IsA("Light") then pcall(function() inst:Destroy() end); return end
    if inst:IsA("Sound") then handleSound(inst); return end
    if CONFIG.RemoveTextures and (inst:IsA("Decal") or inst:IsA("Texture")) then pcall(function() inst:Destroy() end); return end
    
    if CONFIG.ClayLook and inst:IsA("BasePart") then
        if isBall(inst.Name) then initBall(inst) else
            matSize = matSize + 1
            matQueue[matSize] = inst
        end
    end
end

local function drainMaterials()
    if matSize == 0 or camMotion.rotating then return end
    local n = math.min(matSize, 10)
    for i = 1, n do
        local p = matQueue[i]
        if p and p.Parent and not isProtected(p) then
            pcall(function()
                if CONFIG.CacheMaterialForRestore and not CLAY.OriginalMaterial[p] then
                    CLAY.OriginalMaterial[p] = { Material = p.Material, Color = p.Color }
                end
                p.Material, p.Reflectance = Enum.Material.SmoothPlastic, 0
                if CONFIG.RemoveTextures and p:IsA("MeshPart") then p.TextureID = "" end
                CLAY.MaterialAppliedCount = CLAY.MaterialAppliedCount + 1
            end)
        end
    end
    for i = 1, n do matQueue[i] = nil end
    matSize = matSize - n
end

