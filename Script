pcall(function() UserSettings():GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1 end)
pcall(setfpscap, CONFIG.MaxFPS)

applyNetworkOptimizer()
applyClayLighting()

if CONFIG.ShowHUD then pcall(makeHUD) end

-- สแกนและเปลี่ยนวัตถุเป็นดินน้ำมัน
CLAY:TrackThread(task.spawn(function()
    task.wait(0.5)
    local stack, idx = { Workspace }, 1
    while idx <= #stack do
        local cur = stack[idx]; stack[idx] = nil; idx = idx + 1
        if cur and cur.Parent then
            touch(cur)
            if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") and cur ~= LP.Character then 
                local hum = cur:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end) end
            end
            for _, ch in ipairs(cur:GetChildren()) do stack[#stack+1] = ch end
        end
        if idx % 100 == 0 then task.wait() end
    end
end))

CLAY:TrackConn(Workspace.DescendantAdded:Connect(touch))

-- ลูปอัปเดตระบบหลังบ้าน
CLAY:TrackThread(task.spawn(function()
    while CLAY.Running do
        drainMaterials()
        if CONFIG.ShowHUD and HUD.line and HUD.line.Parent then
            local fps = math.floor(1 / RunService.RenderStepped:Wait())
            local ping = 0; pcall(function() ping = math.floor(pingStat:GetValue()) end)
            local ballCount = 0; for _ in pairs(CLAY.BallData) do ballCount = ballCount + 1 end
            
            local fpsColor = fps >= 50 and "#78FF8C" or (fps >= 30 and "#FFE678" or "#FF6E6E")
            -- เพิ่มตัวเลข Clay เพื่อให้รู้ว่าทำงานกี่ชิ้นแล้ว
            HUD.line.Text = string.format("FPS <font color=\"%s\"><b>%d</b></font> | Ping <b>%dms</b> | Ball: %d | Clay: %d", fpsColor, fps, ping, ballCount, CLAY.MaterialAppliedCount)
        else
            task.wait()
        end
    end
end))

-- ลูปอัปเดตบอล
CLAY:TrackThread(task.spawn(function()
    while CLAY.Running do
        RunService.RenderStepped:Wait()
        for realBall in pairs(CLAY.BallData) do sampleBall(realBall) end
        renderBalls()
    end
end))

print("[CLAY-FPS v5.6] ✅ โหลดสำเร็จ! ระบบภาพดินน้ำมันทำงานแล้ว")
