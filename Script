local CLAY = {
    Connections = {}, Threads = {}, Instances = {},
    Processed = setmetatable({}, {__mode = "k"}),
    HighlightCount = 0, Running = true, Paused = false,
    Stats = { fps = 0, ping = 0, frameTime = 0 },
    Aggressive = false, Dirty = false,
    FrozenChars = setmetatable({}, {__mode = "k"}),
